<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup/transfer rules for Android 12 (API 31) and newer.

    The "settings" Preferences DataStore holds the user's VirusTotal API key.
    Even though the key is stored encrypted (Android Keystore, see ApiKeyCipher),
    the Keystore material itself never leaves the device, so the ciphertext is
    useless on another device anyway. It is excluded from both cloud backup and
    device-to-device transfer so the credential is never copied off the device.

    Everything else (e.g. the saved scan history) is backed up normally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/settings.preferences_pb.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/settings.preferences_pb.tmp" />
    </device-transfer>
</data-extraction-rules>
