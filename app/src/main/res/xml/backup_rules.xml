<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 (API 30), the app's minSdk.
    Devices on API 31+ use res/xml/data_extraction_rules.xml instead.

    The "settings" Preferences DataStore holds the (Keystore-encrypted)
    VirusTotal API key and must never be carried into a backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="file" path="datastore/settings.preferences_pb.tmp" />
</full-backup-content>
